{
  "manifest_version": 3,
  "name": "arctictab",
  "version": "1.0.0",
  "description": "Automatically groups your open tabs by topic using an on-device AI embedding model. Nothing leaves your browser: tab titles and page text are embedded locally, clustered into named groups, and applied as native Firefox tab groups. Includes a fast semantic tab search palette.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arctictab@danielmorganrivers.gmail.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "bookmarks"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "commands": {
    "search-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Search open tabs"
    }
  },
  "sidebar_action": {
    "default_title": "arctictab",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon-48.png"
  },
  "action": {
    "default_title": "Open arctictab",
    "default_icon": "icons/icon-48.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendor/transformers/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
